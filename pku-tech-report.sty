\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pku-tech-report}[2026/06/12 Peking University tech report template]

% --------------------------------------------------
% Packages
% --------------------------------------------------
\RequirePackage[a4paper,top=2.2cm,bottom=2.4cm,left=2.4cm,right=2.4cm,headheight=14pt,headsep=16pt,footskip=26pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{placeins}
\RequirePackage{hyphenat}
\RequirePackage{setspace}
\RequirePackage[table]{xcolor}
\RequirePackage{tgheros}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}

% --------------------------------------------------
% Color system
% --------------------------------------------------
\definecolor{pkured}{HTML}{8C0000}
\definecolor{pkuaccent}{HTML}{B8860B}
\definecolor{pkudark}{HTML}{262020}
\definecolor{pkugray}{HTML}{625555}
\definecolor{pkuline}{HTML}{DDC9C9}
\definecolor{pkucard}{HTML}{F8F3F3}

% --------------------------------------------------
% Metadata
% --------------------------------------------------
\newcommand{\pkureportlabel}{Technical Report}
\newcommand{\pkureportshorttitle}{}
\newcommand{\pkubrandmark}{}
\newcommand{\reportlogoheight}{0.72cm}

\newcommand{\techreportlabel}[1]{\renewcommand{\pkureportlabel}{#1}}
\newcommand{\techreportshorttitle}[1]{\renewcommand{\pkureportshorttitle}{#1}}
\newcommand{\techreportbrandmark}[1]{\renewcommand{\pkubrandmark}{#1}}
\newcommand{\techreportlogoheight}[1]{\renewcommand{\reportlogoheight}{#1}}

% --------------------------------------------------
% Typography
% --------------------------------------------------
\newcommand{\pkusans}{\fontfamily{qhv}\selectfont}
\newcommand{\pkutitlefont}{\pkusans\bfseries}
\newcommand{\pkudatefont}{\rmfamily\itshape}
\newcommand{\pkumetalabel}[1]{{\pkusans\small\bfseries\color{pkured} #1:}\hspace{0.35em}}
\newcommand{\techreportmonthyear}{%
  \ifcase\month
  \or January%
  \or February%
  \or March%
  \or April%
  \or May%
  \or June%
  \or July%
  \or August%
  \or September%
  \or October%
  \or November%
  \or December%
  \fi, \number\year
}

% --------------------------------------------------
% Paragraphs and spacing
% --------------------------------------------------
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}
\linespread{1.05}

% --------------------------------------------------
% Caption style
% --------------------------------------------------
\DeclareCaptionLabelSeparator{pkucustom}{}
\DeclareCaptionFormat{pkucustom}{{\pkusans\textbf{#1 #2}} #3}
\captionsetup{
  singlelinecheck=false,
  format=pkucustom,
  labelsep=pkucustom,
  font=small
}

% --------------------------------------------------
% Section style
% --------------------------------------------------
\titleformat*{\section}{\Large\pkusans\bfseries\color{pkudark}}
\titleformat*{\subsection}{\large\pkusans\bfseries\color{pkudark}}
\titleformat*{\subsubsection}{\normalsize\pkusans\bfseries\color{pkudark}}

\titlespacing*{\section}{0pt}{1.2em}{0.6em}
\titlespacing*{\subsection}{0pt}{0.9em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{0.7em}{0.3em}

% --------------------------------------------------
% Abstract
% --------------------------------------------------
\renewenvironment{abstract}
  {%
    \par\noindent
    \small
    \color{pkudark}
  }
  {%
    \par\normalsize
  }

% --------------------------------------------------
% Header and footer
% --------------------------------------------------
\fancypagestyle{firstheader}{
  \fancyhf{}
  \fancyhead[L]{\footnotesize\pkusans\color{pkugray}\pkureportlabel}
  \fancyhead[R]{\pkubrandmark}
  \renewcommand{\headrulewidth}{0.8pt}
  \renewcommand{\headrule}{\hbox to\headwidth{\color{pkuline}\leaders\hrule height \headrulewidth\hfill}}
}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\footnotesize\pkusans\color{pkugray}\thepage}
\renewcommand{\headrulewidth}{0pt}

% --------------------------------------------------
% Title page helpers
% --------------------------------------------------
\newcommand{\techreportlogo}[1]{%
  \raisebox{-0.5\height}{\includegraphics[height=\reportlogoheight]{#1}}\hspace{0.7em}%
}

\newcommand{\techreportlogos}[1]{%
  \noindent
  \begin{minipage}[c]{0.64\linewidth}
    \raggedright
    #1%
  \end{minipage}%
}

\newcommand{\techreportdate}[1]{%
  \begin{minipage}[c]{0.35\linewidth}
    \raggedleft
    {\pkudatefont\small\color{pkugray}#1}
  \end{minipage}\par
}

\newcommand{\techreporttoprule}{%
  \vspace{0.18em}
  \noindent{\color{pkuline}\rule{\linewidth}{0.8pt}\par}
}

\newcommand{\techreporttitle}[1]{%
  \vspace{0.42em}
  \begin{center}
    {{\pkutitlefont\fontsize{18}{21}\selectfont\color{pkudark}#1\par}}
  \end{center}
}

\newcommand{\techreportauthors}[2]{%
  \begin{center}
    {\normalsize\rmfamily\color{pkudark}#1\par}
    \vspace{0.2em}
    {\footnotesize\rmfamily\color{pkugray}#2\par}
  \end{center}
}

\newtcolorbox{pkutitlebox}{
  enhanced,
  frame hidden,
  colback=pkucard,
  colframe=pkuline,
  boxrule=0.5pt,
  arc=8pt,
  left=0.34cm,
  right=0.34cm,
  top=0.28cm,
  bottom=0.28cm,
  before skip=0pt,
  after skip=1.0em,
  drop shadow={opacity=0.06}
}

\newcommand{\techreportmeta}[2]{%
  \ifblank{#2}{}{{\pkumetalabel{#1}#2\par}}%
}

\newcommand{\techreportplaceholder}[1]{%
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=pkuline,
    boxrule=0.6pt,
    arc=6pt,
    height=4.2cm,
    valign=center,
    halign=center
  ]
  {\pkusans\small\color{pkugray}#1}
  \end{tcolorbox}
}

% --------------------------------------------------
% Utilities
% --------------------------------------------------
\newcommand{\highlight}[1]{\textcolor{pkuaccent}{\textbf{#1}}}

\newcommand{\pkudivider}{%
  \vspace{0.6em}
  {\color{pkuline}\hrule height 0.6pt}
  \vspace{0.6em}
}
