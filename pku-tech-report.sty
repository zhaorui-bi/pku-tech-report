\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pku-tech-report}[2026/11/15 PKU technical report layout]
\RequirePackage[a4paper,margin=24mm,top=22mm,bottom=24mm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{amsmath,amssymb}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{tcolorbox}
\RequirePackage{hyperref}
\definecolor{PKURed}{HTML}{8C0000}
\definecolor{PKUText}{HTML}{262020}
\definecolor{PKUMuted}{HTML}{625555}
\definecolor{PKULine}{HTML}{DDC9C9}
\definecolor{PKUPaper}{HTML}{F8F3F3}
\hypersetup{colorlinks=true,linkcolor=PKURed,citecolor=PKURed,urlcolor=PKURed}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}
\linespread{1.05}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\small\sffamily\color{PKUMuted}\thepage}
\renewcommand{\headrulewidth}{0pt}
\titleformat{\section}{\Large\sffamily\bfseries\color{PKUText}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\large\sffamily\bfseries\color{PKUText}}{\thesubsection}{0.7em}{}
\captionsetup{font=small,labelfont={sf,bf},singlelinecheck=false}
\newcommand{\ReportHeader}[2]{%
  \noindent\begin{minipage}[c]{.65\textwidth}%
    \includegraphics[height=#2]{#1}%
  \end{minipage}%
  \begin{minipage}[c]{.35\textwidth}\raggedleft
    \small\itshape\color{PKUMuted}\today
  \end{minipage}\par\vspace{.2em}%
  {\color{PKULine}\hrule height .6pt}\vspace{1em}%
}
\newcommand{\ReportTitle}[3]{%
  \begin{center}
    {\sffamily\bfseries\fontsize{18}{22}\selectfont\color{PKUText}#1\par}
    \vspace{.8em}
    {\normalsize #2\par}\vspace{.25em}
    {\footnotesize\color{PKUMuted}#3\par}
  \end{center}\vspace{.4em}%
}
\newcommand{\ReportTeaserPlaceholder}[1]{%
  \begin{tcolorbox}[colback=white,colframe=PKULine,boxrule=.5pt,arc=5pt,
    height=4.2cm,valign=center,halign=center]
    {\small\sffamily\color{PKUMuted}#1}
  \end{tcolorbox}%
}
\newenvironment{ReportSummary}{%
  \begin{tcolorbox}[colback=PKUPaper,colframe=PKUPaper,arc=6pt,
    boxrule=0pt,left=4mm,right=4mm,top=3mm,bottom=3mm]
  \small\setlength{\parindent}{0pt}\setlength{\parskip}{.35em}%
}{\end{tcolorbox}}
\newcommand{\ReportInfo}[2]{\par{\sffamily\bfseries\color{PKURed}#1:} #2}
